[Unit]
Description=FreeAlien thermal control service
Requires=awcfree-thermals.socket
After=awcfree-thermals.socket systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/libexec/awcfree-thermals serve --uid @UID@
User=root
Group=root
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadOnlyPaths=/sys /proc /run
# Only the discovered Alienware WMI device trees are writable.
@WRITE_PATHS@
TasksMax=16
MemoryMax=128M
